---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate } = Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: '2-digit' });
}
---

<html lang="en">
  <head>
    <BaseHead title={`${title} - zavjs`} description={description} />
  </head>
  <body>
    <Header />
    <div class="post-detail">
      <a class="post-detail__back" href="/">← Home</a>
      <h1 class="post-detail__title">{title}</h1>
      <h3 class="post-detail__date">{formatDate(pubDate)}</h3>
      <div class="post-detail__content">
        <div class="post-detail__markdown">
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>
